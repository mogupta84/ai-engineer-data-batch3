# Copy this file to .env (same folder) and fill in the lines your trainer gives you.
# The .env file stays on your laptop: it is listed in .gitignore and never goes to GitHub.

# Your class account with dashes, lower case: itc_ai_1 becomes itc-ai-1. Names your Day 2 index and your pgvector table.
STUDENT=

# Your class search service: https://freshcart-search-teams.search.windows.net or ...teams2...
SEARCH_ENDPOINT=
# The search service's query key: it can read, not change. Leave empty if your trainer says your sign-in has access.
SEARCH_QUERY_KEY=

# Day 2 and the trainer's index script: Document Intelligence
DOCINTEL_ENDPOINT=https://freshcart-docintel-itc.cognitiveservices.azure.com/

# Day 2 benchmark: the class PostgreSQL server, given by your trainer on the day
PG_CONNECTION=
# Trainer only (trainer_build_scale.py): the password to give the students' login, class_student
# PG_STUDENT_PASSWORD=

# Day 4 --upload only: the Foundry project
FOUNDRY_PROJECT_ENDPOINT=https://itc-ai-trainer-0359-resource.services.ai.azure.com/api/projects/itc-ai-trainer-0359

# Already set; change only if your trainer says so
# FOUNDRY_OPENAI_ENDPOINT=https://itc-ai-trainer-0359-resource.services.ai.azure.com/openai/v1
# CHAT_MODEL=gpt-4.1-mini
# EMBED_MODEL=text-embedding-3-small
